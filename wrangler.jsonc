{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pairify",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "dist/pairify/browser",
    // The router uses path URLs, so deep links like /persons need index.html
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "pairify.skillbird.de", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
